// ─────────────────────────────────────────────
// CentralEats — Schema Prisma v3.0
// Fuente de verdad del modelo relacional.
// Fecha: 2026-06-23
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum UserRole {
  PENDING
  STUDENT
  VENDOR
  ADMIN
}

/// Ciclo de vida de una orden (7 fases + 1 excepción).
/// Lenguaje Ubicuo aprobado en Doc. 08.x v4.0
enum OrderStatus {
  PENDING_PAYMENT // 1. Orden creada, esperando pago
  PAID            // 2. Pago confirmado por la plataforma
  RECEIVED        // 3. Vendor recibió la notificación
  PREPARING       // 4. Vendor está preparando el pedido
  READY           // 5. Pedido listo para ser recogido
  PICKED_UP       // 6. Estudiante recogió el pedido
  COMPLETED       // 7. Ciclo de vida finalizado exitosamente
  CANCELLED       // Excepción: orden cancelada en cualquier fase válida
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum NotificationType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_RECEIVED
  ORDER_PREPARING
  ORDER_READY
  ORDER_PICKED_UP
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  SYSTEM
}

// ═══════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════

/// Usuario del sistema. Identidad manejada por Clerk.
/// El backend SOLO almacena datos de negocio, NO contraseñas.
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  fullName  String?
  avatarUrl String?
  role      UserRole @default(PENDING)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders        Order[]
  notifications Notification[]
  vendor        Vendor? // 1:1 — un usuario VENDOR tiene máximo UN local en el campus UCE

  @@index([clerkId])
  @@index([role])
}

/// Establecimiento/puesto de comida dentro del campus UCE.
/// Restricción de dominio: 1 propietario = 1 local (ownerId @unique).
/// Todos los campos de perfil son REQUERIDOS para garantizar la integridad del catálogo.
model Vendor {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String   // Obligatorio: ubicación física dentro del campus UCE
  phone       String   // Obligatorio: contacto del local
  logoUrl     String?
  openingTime String   // Formato HH:mm (ej: "08:00")
  closingTime String   // Formato HH:mm (ej: "17:00")
  isActive    Boolean  @default(true)
  ownerId     String   @unique // @unique: 1 dueño = 1 local en el campus UCE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner    User      @relation(fields: [ownerId], references: [id])
  products Product[]
  orders   Order[]

  @@index([isActive])
}

/// Categoría de productos del catálogo.
/// Gestionada exclusivamente por ADMIN.
/// Categorías amplias para soportar diversidad gastronómica del campus.
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]
}

/// Producto del catálogo de un Vendor.
/// ARQUITECTURA DE CENTAVOS: price en Int ($3.50 → 350 centavos).
/// stock OBLIGATORIO: sin default implícito. Garantiza auditoría de inventario.
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // Centavos. Ej: $3.50 → 350. Sin Decimal para erradicar errores IEEE 754.
  stock       Int      // OBLIGATORIO. Sin @default. El Vendor siempre declara su inventario inicial.
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isActive    Boolean  @default(true)
  vendorId    String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isAvailable])
}

/// Pedido realizado por un estudiante a un Vendor.
/// Estado sigue el Order Lifecycle (Doc. 08.x) con 7 fases + 1 excepción.
/// ARQUITECTURA DE CENTAVOS: totalAmount en Int.
model Order {
  id          String      @id @default(uuid())
  userId      String
  vendorId    String
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Int         // Centavos. Consistencia matemática con Product.price.
  pickupCode  String?     @unique
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  items         OrderItem[]
  payment       Payment?
  notifications Notification[]

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

/// Línea de detalle de un pedido. Inmutable después de creación.
/// ARQUITECTURA DE CENTAVOS: unitPrice captura el precio histórico en centavos.
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int      // Precio histórico del producto al momento de la compra (centavos).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// Registro de pago de un pedido.
/// idempotencyKey previene cobros duplicados.
/// ARQUITECTURA DE CENTAVOS: amount en Int.
model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  amount         Int           // Centavos. Alineado con Order.totalAmount.
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id])
}

/// Notificación en tiempo real para un usuario.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  orderId   String?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, isRead])
  @@index([orderId])
}
